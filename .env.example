# ─────────────────────────────────────────────────────────────────────────────
# NEX CARD — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# MySQL connection string (omit to use mock JSON database in development)
DATABASE_URL="mysql://user:password@localhost:3306/nexcard"

# Public app URL — used for canonical URLs, QR codes, OG images, sitemap
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Security ─────────────────────────────────────────────────────────────────

# Secret for /api/revalidate webhook (generate with: openssl rand -hex 32)
REVALIDATION_SECRET="change-me-to-a-random-secret"

# ── Cloudflare R2 Storage (optional — required for image uploads) ────────────

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://cdn.nexcard.io"

# ── Runtime ──────────────────────────────────────────────────────────────────

NODE_ENV="development"
