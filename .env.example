# ─────────────────────────────────────────────────────────────────────────────
# NEX CARD — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# MySQL connection string (omit to use mock JSON database in development)
DATABASE_URL="mysql://user:password@localhost:3306/nexcard"

# Public app URL — used for canonical URLs, QR codes, OG images, sitemap
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Security ─────────────────────────────────────────────────────────────────

# Secret for /api/revalidate webhook (generate with: openssl rand -hex 32)
REVALIDATION_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Cron cleanup: POST /api/cron/cleanup-sessions with Authorization: Bearer <secret>
# Required in production (openssl rand -hex 32)
CRON_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Optional: Sentry DSN for error reporting (leave empty to log to console only)
# SENTRY_DSN="https://publicKey@o0.ingest.sentry.io/0"

# Seed passwords (applied ONLY on first create — re-seed never overwrites)
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="use-a-long-random-password"
# SEED_DEMO_EMAIL="user@gmail.com"
# SEED_DEMO_PASSWORD="use-a-long-random-password"

# ── File Storage ───────────────────────────────────────────────────────────────
# Choose ONE driver. Unused provider blocks can be deleted from your .env.
# local (default) — saves to public/uploads/ on your VPS (free, no VPN)
# In production, set ALLOW_LOCAL_STORAGE=true if you intentionally use VPS disk.

# Laptop / local run: STORAGE_DRIVER=local
#   gallery/avatars → public/uploads/
#   payment proofs → data/private-uploads/ (not statically served)
# Server: STORAGE_DRIVER=r2
#   gallery/avatars → public CDN (R2_PUBLIC_URL)
#   payment proofs → private object keys, streamed via GET /api/payments/proof/{id}
# Admins must enable TOTP at /admin/security before other admin pages.
STORAGE_DRIVER="local"
ALLOW_LOCAL_STORAGE="true"
# STORAGE_DRIVER="r2"
# STORAGE_DRIVER="cloudinary"
# STORAGE_DRIVER="supabase"

# ── Local storage (STORAGE_DRIVER=local) ─────────────────────────────────────
# No extra vars — files go to public/uploads/{folder}/

# ── Cloudflare R2 (STORAGE_DRIVER=r2) ────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://cdn.www.nexcard.wetechmm.com"
# Optional private bucket for payment screenshots (no custom domain). If unset, proofs use
# R2_BUCKET_NAME + private/ prefix — add a Cloudflare rule to deny public GET on private/*
# R2_PRIVATE_BUCKET="nexcard-private"
# Optional: enable JSON presigned client uploads (advanced). Never used for payments.
# STORAGE_R2_USE_PRESIGNED="true"

# ── Cloudinary (STORAGE_DRIVER=cloudinary) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="nexcard"

# ── Supabase Storage (STORAGE_DRIVER=supabase) ────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nexcard-uploads"

# ── Runtime ──────────────────────────────────────────────────────────────────

NODE_ENV="development"

# ── SMTP (required for launch — registration always verifies email) ──────────
# Without SMTP, accounts are created but users never receive a code and cannot log in.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_USER="noreply@www.nexcard.wetechmm.com"
# BACKUP_EMAIL_TO="admin@example.com"

# ── Cron (session + email-token cleanup) ─────────────────────────────────────
# POST /api/cron/cleanup-sessions with Authorization: Bearer $CRON_SECRET
# (CRON_SECRET is required in production — see Security section above)
