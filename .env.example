# ─────────────────────────────────────────────────────────────────────────────
# NEX CARD — Environment Variables
# Copy this file to .env.local and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# MySQL connection string (omit to use mock JSON database in development)
DATABASE_URL="mysql://user:password@localhost:3306/nexcard"

# Public app URL — used for canonical URLs, QR codes, OG images, sitemap
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Security ─────────────────────────────────────────────────────────────────

# Secret for /api/revalidate webhook (generate with: openssl rand -hex 32)
REVALIDATION_SECRET="change-me-to-a-random-secret"

# ── File Storage ───────────────────────────────────────────────────────────────
# Choose ONE driver. Unused provider blocks can be deleted from your .env.
# local (default) — saves to public/uploads/ on your VPS (free, no VPN)

STORAGE_DRIVER="local"
# STORAGE_DRIVER="r2"
# STORAGE_DRIVER="cloudinary"
# STORAGE_DRIVER="supabase"

# ── Local storage (STORAGE_DRIVER=local) ─────────────────────────────────────
# No extra vars — files go to public/uploads/{folder}/

# ── Cloudflare R2 (STORAGE_DRIVER=r2) ────────────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://cdn.nexcard.io"
# Optional: enable JSON presigned client uploads (advanced)
# STORAGE_R2_USE_PRESIGNED="true"

# ── Cloudinary (STORAGE_DRIVER=cloudinary) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="nexcard"

# ── Supabase Storage (STORAGE_DRIVER=supabase) ────────────────────────────────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nexcard-uploads"

# ── Runtime ──────────────────────────────────────────────────────────────────

NODE_ENV="development"
