generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  emailVerifiedAt   DateTime?
  hashedPassword    String
  name              String
  avatarUrl         String?
  role              UserRole           @default(USER)
  status            UserStatus         @default(PENDING_VERIFICATION)
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  /// Base32 TOTP secret for optional admin 2FA (null = disabled)
  totpSecret        String?            @db.VarChar(64)
  totpEnabled       Boolean            @default(false)
  emailTokens       EmailToken[]
  payments          Payment[]
  sessions          Session[]
  profiles          UserProfile[]
  verificationCodes VerificationCode[]

  @@index([email])
  @@index([status])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@map("sessions")
}

model Category {
  id          String        @id @default(cuid())
  name        String        @unique
  slug        String        @unique
  description String?       @db.Text
  iconName    String?
  sortOrder   Int           @default(0)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  templates   Template[]
  profiles    UserProfile[]
  coupons     Coupon[]

  @@index([slug])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Template {
  id             String        @id @default(cuid())
  categoryId     String
  codeIdentifier String        @unique
  name           String
  description    String?       @db.Text
  thumbnailUrl   String
  previewUrl     String?
  accentColor    String?
  isPremium      Boolean       @default(false)
  isActive       Boolean       @default(true)
  sortOrder      Int           @default(0)
  priceQrOnly    Float?
  priceNfcQr     Float?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  category       Category      @relation(fields: [categoryId], references: [id])
  profiles       UserProfile[]

  @@index([categoryId])
  @@index([codeIdentifier])
  @@index([isActive])
  @@index([sortOrder])
  @@map("templates")
}

model UserProfile {
  id               String                  @id @default(cuid())
  userId           String
  categoryId       String
  templateId       String
  templateLocked   Boolean                 @default(false)
  slug             String                  @unique
  isPublished      Boolean                 @default(false)
  viewCount        BigInt                  @default(0)
  dynamicJsonData  Json
  qrLocked         Boolean                 @default(false)
  qrGeneratedAt    DateTime?
  qrScanCount      BigInt                  @default(0)
  nfcWriteCount    BigInt                  @default(0)
  nfcProgrammedAt  DateTime?
  paymentStatus    PaymentStatus?
  companyName      String?                   @db.VarChar(120)
  companyVerified  CompanyVerificationStatus @default(NOT_SUBMITTED)
  companyVerifiedAt DateTime?
  metaTitle        String?                 @db.VarChar(160)
  metaDescription  String?                 @db.VarChar(320)
  ogImageUrl       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  nfcFulfillment   NfcFulfillmentStatus    @default(NOT_ORDERED)
  payment          Payment?
  analyticsEvents  ProfileAnalyticsEvent[]
  category         Category                @relation(fields: [categoryId], references: [id])
  template         Template                @relation(fields: [templateId], references: [id])
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestbookEntries WeddingGuestbook[]
  weddingRsvps     WeddingRsvp[]

  @@unique([userId, categoryId])
  @@index([slug])
  @@index([userId])
  @@index([categoryId])
  @@index([templateId])
  @@index([isPublished])
  @@index([createdAt])
  @@index([qrLocked])
  @@index([paymentStatus])
  @@index([nfcFulfillment])
  @@map("user_profiles")
}

model Payment {
  id             String        @id @default(cuid())
  userId         String
  userProfileId  String        @unique
  tier           payments_tier
  amount         Float
  currency       String        @default("MMK")
  /// Original price before discount
  originalPrice  Float?
  /// Discount percentage applied from coupon
  discountPct    Float?
  /// Coupon code used (denormalized for audit)
  couponCode     String?       @db.VarChar(30)
  /// Company/org name for automatic discount
  companyName     String?       @db.VarChar(120)
  /// Discount breakdown JSON: { company: 5, bulk: 10, coupon: 5 }
  discountBreakdown Json?
  /// Screenshot proof — still required as fallback for Wave/KBZ manual rails
  screenshotUrl  String        @db.VarChar(500)
  status         PaymentStatus @default(PENDING)
  adminNote      String?       @db.VarChar(500)
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  method         PaymentMethod @default(KBZPay)
  /// Optional bank/wallet transaction reference from the payer
  transactionRef String?       @db.VarChar(120)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userProfile    UserProfile   @relation(fields: [userProfileId], references: [id], onDelete: Cascade)
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  couponId       String?

  @@index([userId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
  @@index([couponId])
  @@map("payments")
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique @db.VarChar(30)
  categoryId     String
  discountQrOnly Float     @default(0)
  discountNfcQr  Float     @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  maxUses        Int?
  usageCount     Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  category       Category  @relation(fields: [categoryId], references: [id])
  payments       Payment[]

  @@index([code])
  @@index([categoryId])
  @@index([isActive])
  @@map("coupons")
}

model DiscountRule {
  id             String            @id @default(cuid())
  name           String            @db.VarChar(100)
  type           DiscountRuleType
  percentage     Float
  minQuantity    Int?
  isActive       Boolean           @default(true)
  appliedCount   Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("discount_rules")
}

model ProfileAnalyticsEvent {
  id        String             @id @default(cuid())
  profileId String
  type      AnalyticsEventType
  referrer  String?            @db.VarChar(500)
  userAgent String?            @db.VarChar(500)
  device    String?            @db.VarChar(40)
  /// UTC calendar day YYYY-MM-DD for cheap grouping
  day       String             @db.VarChar(10)
  createdAt DateTime           @default(now())
  profile   UserProfile        @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, type, day])
  @@index([profileId, createdAt])
  @@index([day])
  @@map("profile_analytics_events")
}

model WeddingRsvp {
  id          String      @id @default(cuid())
  profileId   String
  guestName   String      @db.VarChar(120)
  email       String?     @db.VarChar(160)
  phone       String?     @db.VarChar(40)
  attending   Boolean     @default(true)
  guestCount  Int         @default(1)
  mealNote    String?     @db.VarChar(240)
  message     String?     @db.VarChar(500)
  createdAt   DateTime    @default(now())
  dietary     String?     @db.VarChar(240)
  mealChoice  String?     @db.VarChar(120)
  plusOneName String?     @db.VarChar(120)
  songRequest String?     @db.VarChar(120)
  profile     UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
  @@map("wedding_rsvps")
}

model WeddingGuestbook {
  id        String      @id @default(cuid())
  profileId String
  author    String      @db.VarChar(120)
  message   String      @db.VarChar(1000)
  isPublic  Boolean     @default(true)
  createdAt DateTime    @default(now())
  profile   UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([createdAt])
  @@map("wedding_guestbook")
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  type      EmailTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([type])
  @@index([expiresAt])
  @@map("email_tokens")
}

model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  code      String
  purpose   String    @default("register")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([code])
  @@index([purpose])
  @@map("verification_codes")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(80)
  targetType String?  @db.VarChar(60)
  targetId   String?  @db.VarChar(64)
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum UserRole {
  ADMIN
  USER
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  KBZPay
  WavePay
  AYAPay
  CBPay
  OTHER
}

enum NfcFulfillmentStatus {
  NOT_ORDERED
  PENDING_WRITE
  PROGRAMMED
  SHIPPED
}

enum AnalyticsEventType {
  VIEW
  QR_SCAN
  NFC_TAP
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum payments_tier {
  QR_ONLY
  NFC_QR
}

enum DiscountRuleType {
  COMPANY
  BULK
}

enum CompanyVerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}
